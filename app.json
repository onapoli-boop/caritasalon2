{
  "expo": {
    "name": "GlowPass Merchant",
    "slug": "glowpass-merchant",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "glowpass-merchant",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": { "supportsTablet": false, "bundleIdentifier": "com.glowpass.merchant", "buildNumber": "1" },
    "android": {
      "package": "com.glowpass.merchant",
      "versionCode": 1,
      "adaptiveIcon": { "foregroundImage": "./assets/images/icon.png", "backgroundColor": "#FFFAF6" }
    },
    "web": { "bundler": "metro", "output": "static", "favicon": "./assets/images/favicon.png" },
    "plugins": [
      "expo-router",
      "expo-font",
      ["expo-camera", { "cameraPermission": "Utilisé pour scanner les QR codes des clients." }],
      ["expo-image-picker", { "photosPermission": "Utilisé pour la photo de profil et le logo du commerçant." }],
      ["expo-splash-screen", { "image": "./assets/images/icon.png", "backgroundColor": "#FFFAF6" }]
    ],
    "experiments": { "typedRoutes": true }
  }
}
